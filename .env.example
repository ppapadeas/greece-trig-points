# This is an example file. Copy to .env for local development.

# Backend Port
PORT=3001

# Database Connection (for the 'db' service in Docker Compose)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=greece_trig_points
DATABASE_URL=postgres://user:password@db:5432/greece_trig_points

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Other Backend Secrets
SESSION_SECRET=
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Protomaps PMTiles (Cloudflare Worker serving tiles from R2)
VITE_PMTILES_URL=https://vathra-tiles.vathra.workers.dev
